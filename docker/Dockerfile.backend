# ============================================
# Dockerfile Multi-Stage para Backend
# ============================================
# Decisão: Multi-stage para otimizar tamanho da imagem
# - Stage 1: Build (compila TypeScript)
# - Stage 2: Production (apenas runtime)

# ============================================
# Stage 1: Build
# ============================================
FROM node:20-alpine AS builder

# Metadados
LABEL maintainer="hotel-reservation-team"
LABEL description="Backend do Sistema de Reserva Hoteleira"

# Definir diretório de trabalho
WORKDIR /app

# Copiar arquivos de dependências
# Decisão: Copiar apenas package*.json primeiro para aproveitar cache do Docker
COPY backend/package*.json ./

# Instalar dependências (incluindo devDependencies para build)
RUN npm ci --only=production=false

# Copiar código fonte
COPY backend/ ./

# Compilar TypeScript
# Decisão: Compilar no build para não precisar de TypeScript em produção
RUN npm run build

# ============================================
# Stage 2: Production
# ============================================
FROM node:20-alpine AS production

# Instalar apenas dependências de runtime
RUN apk add --no-cache \
    tini \
    # tini: gerenciador de processos para containers
    && rm -rf /var/cache/apk/*

# Criar usuário não-root para segurança
# Decisão: Não executar como root por segurança
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# Copiar package.json para instalar apenas dependências de produção
COPY backend/package*.json ./

# Instalar apenas dependências de produção
RUN npm ci --only=production && \
    npm cache clean --force

# Copiar código compilado do stage anterior
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist

# Mudar para usuário não-root
USER nodejs

# Expor porta da aplicação
EXPOSE 3000

# Healthcheck
# Decisão: Verificar saúde da aplicação periodicamente
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Usar tini como entrypoint para gerenciar sinais
ENTRYPOINT ["/sbin/tini", "--"]

# Comando para iniciar aplicação
CMD ["node", "dist/server.js"]
