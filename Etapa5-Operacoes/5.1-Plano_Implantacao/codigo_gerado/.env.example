# =============================================================================
# .env.example — Variáveis de ambiente necessárias
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores marcados com <ALTERAR>
# 3. NUNCA commite o arquivo .env — ele está no .gitignore
#
# Em produção, estas variáveis são gerenciadas por:
#   - GitHub Actions Secrets (para o pipeline CI/CD)
#   - Secrets manager do servidor (ex: env vars no systemd ou Docker Secrets)
# =============================================================================

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_DB=hotel_reservas
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=<ALTERAR — mínimo 20 caracteres, nunca use senha padrão>

# URL completa usada pelo Prisma / pg client na API
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://hotel_user:<SENHA>@hotel-db:5432/hotel_reservas

# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<ALTERAR — string aleatória de 64+ bytes>
JWT_EXPIRES_IN=8h

# ── Servidor Node.js ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug          # debug | info | warn | error

# ── Imagens Docker ────────────────────────────────────────────────────────────
REGISTRY=ghcr.io
IMAGE_TAG=latest

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL da API vista pelo browser.
# Em desenvolvimento local: http://localhost:3000
# Em produção com Nginx proxy: /api (mesmo origin, sem CORS)
VITE_API_URL=http://localhost:3000
