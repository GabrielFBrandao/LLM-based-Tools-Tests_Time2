# =============================================================================
# Dockerfile — API Node.js (Hotel Reservas)
#
# ESTRATÉGIA: Build multi-estágio
#
# Stage 1 — deps:    instala APENAS dependências de produção
# Stage 2 — builder: compila TypeScript → JavaScript (dist/)
# Stage 3 — runner:  imagem mínima com apenas o artefato compilado
#
# DECISÃO — POR QUE MULTI-STAGE?
# A imagem final NÃO contém:
#   - Código-fonte TypeScript (.ts)
#   - devDependencies (jest, ts-jest, @types/*, typescript)
#   - node_modules de desenvolvimento (~300 MB removidos)
#   - Cache do npm
#
# Resultado: imagem de produção com ~80 MB vs ~500 MB de uma imagem simples.
#
# DECISÃO — node:22-alpine como base:
# Alpine Linux (~5 MB base) + Node.js LTS.
# Não usamos "distroless" aqui porque o Alpine já é suficientemente mínimo
# e ainda permite inspecionar o container em debug (sh disponível).
# =============================================================================

# ── Stage 1: Dependências de produção ────────────────────────────────────────
FROM node:22-alpine AS deps

# Instala dumb-init: gerenciador de processo mínimo que garante
# que sinais (SIGTERM, SIGINT) sejam propagados corretamente para o Node.
# Sem ele, "docker stop" pode levar 10s até forçar SIGKILL.
RUN apk add --no-cache dumb-init

WORKDIR /app

# Copia apenas os manifests de dependência primeiro.
# DECISÃO: Se package.json não mudar, o Docker reutiliza o cache desta
# camada em builds subsequentes — não reinstala tudo quando só o
# código-fonte mudou.
COPY package.json package-lock.json* ./

# --omit=dev: instala apenas produção (exclui jest, ts-jest, etc.)
# --frozen-lockfile: garante reprodutibilidade — falha se lock estiver desatualizado
RUN npm ci --omit=dev --frozen-lockfile


# ── Stage 2: Compilação TypeScript ───────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copia manifests + instala TODAS as dependências (inclui devDeps para tsc)
COPY package.json package-lock.json* ./
RUN npm ci --frozen-lockfile

# Copia código-fonte
COPY tsconfig.json ./
COPY src/ ./src/

# Compila TypeScript → JavaScript em ./dist/
# noEmitOnError: falha o build se houver erros de tipo
RUN npx tsc --noEmitOnError

# ── Stage 3: Imagem final de produção ────────────────────────────────────────
FROM node:22-alpine AS runner

# Metadados OCI para rastreabilidade
LABEL org.opencontainers.image.title="hotel-reservas-api"
LABEL org.opencontainers.image.description="API REST — Sistema de Reserva de Hotel"
LABEL org.opencontainers.image.vendor="hotel-app"

# DECISÃO — Usuário não-root:
# Containers devem rodar como usuário sem privilégios (princípio do menor privilégio).
# node:alpine já vem com usuário "node" (UID 1000) — apenas ativamos aqui.
RUN apk add --no-cache dumb-init

WORKDIR /app

# Copia node_modules de produção do stage deps
COPY --from=deps /app/node_modules ./node_modules

# Copia JavaScript compilado do stage builder
COPY --from=builder /app/dist ./dist

# Copia package.json (necessário para npm start e metadados de versão)
COPY package.json ./

# Muda propriedade dos arquivos para o usuário node
RUN chown -R node:node /app

USER node

# Porta exposta pelo servidor Express
EXPOSE 3000

# DECISÃO — dumb-init como entrypoint:
# Garante que Node.js receba SIGTERM corretamente para graceful shutdown.
# Sem isso, o Node roda como PID 1 e pode não processar sinais do Docker.
ENTRYPOINT ["dumb-init", "--"]

# Inicia o servidor compilado
CMD ["node", "dist/server.js"]
